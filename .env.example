# ============================================================
#  MoneyStatBot sozlamalari
#  Nusxa oling:  cp .env.example .env   — keyin quyidagilarni to'ldiring.
#  .env faylini HECH QACHON git'ga qo'ymang va hech kimga yubormang.
# ============================================================

# --- MAJBURIY ---------------------------------------------------

# @BotFather -> /newbot -> bergan token
BOT_TOKEN=

# Sizning Telegram ID raqamingiz (@userinfobot ga /start yozing).
# Bot faqat shu foydalanuvchiga javob beradi.
OWNER_ID=

# Baza paroli — o'zingiz o'ylab toping. Faqat harf va raqam ishlating
# (maxsus belgilar baza manzilini buzadi). Masalan: openssl rand -hex 16
POSTGRES_PASSWORD=

# Vaqt zonasi (statistika va eslatmalar uchun)
TIMEZONE=Asia/Tashkent

# --- IXTIYORIY: Mini App (HTTPS) --------------------------------
# Bo'sh qoldirsangiz bot polling rejimida ishlaydi — domen ham, ochiq port
# ham kerak emas. Mini App (grafiklar paneli) uchun domen kerak:
#   DOMAIN=bot.example.com
#   PUBLIC_URL=https://bot.example.com
# va ishga tushirish:  docker compose --profile https up -d --build
DOMAIN=
PUBLIC_URL=
PORT=10000

# --- IXTIYORIY: avtomatik o'qish (userbot) -----------------------
# Bo'sh bo'lsa bank xabarlarini botga qo'lda forward qilasiz.
# API_ID / API_HASH:  https://my.telegram.org -> API development tools
# SESSION_STRING:     docker compose run --rm bot python scripts/gen_session.py
# DIQQAT: SESSION_STRING Telegram akkauntingizga TO'LIQ kirish beradi.
API_ID=0
API_HASH=
SESSION_STRING=

# --- Faqat Docker'siz ishga tushirganda -------------------------
# Docker compose bu qiymatni o'zi beradi.
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/moneystat
